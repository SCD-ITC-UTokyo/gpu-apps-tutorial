## default settings.
FP       ?= 32
NTHREADS ?= 128

## Compiler

## NVIDIA Compiler version 24.1 or former
# CXX = not available
# CC  = not available
# F90 = not available

## NVIDIA Compiler version 24.5 or later
CXX = nvc++ -std=c++17 -mp -acc=gpu -gpu=mem:unified:nomanagedalloc
CC  = nvc              -mp -acc=gpu -gpu=mem:unified:nomanagedalloc
F90 = nvfortran -cpp   -mp -acc=gpu -gpu=mem:unified:nomanagedalloc

## Compile Options
FLAGS = -tp=native -O3 -I. -Wall -Minfo=accel,opt,mp
FFLAGS = -Imod -module mod

# floating point type
FLAGS += -DFP=$(FP)

# for benchmarking
FLAGS += -DBENCHMARK_MODE

# for finding the best threads
FLAGS += -DNTHREADS=$(NTHREADS)

## Additional C++ Library for Fortran90 Programs
#LIBS += -lstdc++

##---------------------------------------------------------------------------
## Make rules
TARGET = diffusion.uni.$(FP)

OBJS = misc.o diffusion.o main.o

all: show_config $(TARGET)

.SUFFIXES:
.SUFFIXES: .cpp .c .f90 .o

%.o: %.c	
	$(CC)  -c $(FLAGS) $< -o $@

%.o: %.cpp
	$(CXX) -c $(FLAGS) $< -o $@

%.o: %.f90
	mkdir -p mod
	$(F90) -c $(FLAGS) $(FFLAGS) $< -o $@

$(TARGET): $(OBJS)
#	$(CXX) $(OBJS) $(LIBS) -o $@
	$(CC)  $(OBJS) $(LIBS) -o $@
#	$(F90) $(OBJS) $(LIBS) -o $@

install: $(TARGET)
	mkdir -p ../bin ../log
	cp -f  $(TARGET) ../bin

clean:
	rm -f $(TARGET) *.o */*.mod *~

show_config:
	@echo "======================================"
	@echo "UNI FP=$(FP) NTHREADS=$(NTHREADS)     "
	@echo "======================================"

main.o: diffusion.h misc.h
diffusion.o: misc.h
misc.o: misc.h
