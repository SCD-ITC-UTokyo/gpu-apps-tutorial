## default settings.
FP       ?= 32

## Compiler

#CXX = icpx -std=c++17 -qopenmp
#CC  = icx -qopenmp
#F90 = ifx -fpp -qopenmp

CXX = g++ -std=c++17 -fopenmp
CC  = gcc -fopenmp
F90 = gfortran -cpp -fopenmp

## Compile Options

#FLAGS= -O3 -I.
#FFLAGS = -I mod -module mod
FLAGS = -O3 -I.
FFLAGS = -Imod -Jmod

# floating point type
FLAGS += -DFP=$(FP)

# for benchmarking
FLAGS += -DBENCHMARK_MODE

## Libraries
LIBS = -lm

## Additional C++ Library for Fortran90 Programs
#LIBS += -lstdc++

##---------------------------------------------------------------------------
## Make rules
TARGET = diffusion.cpu.$(FP)

OBJS = misc.o diffusion.o main.o

all: show_config $(TARGET)

.SUFFIXES:
.SUFFIXES: .cpp .c .f90 .o

%.o: %.c	
	$(CC)  -c $(FLAGS) $< -o $@

%.o: %.cpp
	$(CXX) -c $(FLAGS) $< -o $@

%.o: %.f90
	mkdir -p mod
	$(F90) -c $(FLAGS) $(FFLAGS) $< -o $@

$(TARGET): $(OBJS)
#	$(CXX) $(OBJS) $(LIBS) -o $@
#	$(CC)  $(OBJS) $(LIBS) -o $@
	$(F90) $(OBJS) $(LIBS) -o $@

install: $(TARGET)
	mkdir -p ../bin ../log
	cp -f  $(TARGET) ../bin

clean:
	rm -f $(TARGET) *.o */*.mod *~

show_config:
	@echo "======================================"
	@echo "CPU FP=$(FP)                          "
	@echo "======================================"

main.o: diffusion.f90 misc.f90
diffusion.o: misc.f90
misc.o: misc.f90
