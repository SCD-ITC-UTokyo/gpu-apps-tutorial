## default settings.
FP       ?= 32

## Compiler

CXX = icpx -std=c++17 -qopenmp --gcc-toolchain=/opt/rh/gcc-toolset-14/root/usr
CC  = icx -qopenmp --gcc-toolchain=/opt/rh/gcc-toolset-14/root/usr
F90 = ifx -fpp -qopenmp

#CXX = g++ -std=c++17 -fopenmp
#CC  = gcc -fopenmp
#F90 = gfortran -std=f2023 -cpp -fopenmp

## Compile Options

FLAGS= -O3 -I.
FFLAGS = -I mod -module mod
#FLAGS = -O3 -I.
#FFLAGS = -Imod -Jmod

# floating point type
FLAGS += -DFP=$(FP)

# for benchmarking
FLAGS += -DBENCHMARK_MODE

## Libraries
LIBS = -ltbb

## Additional C++ Library for Fortran90 Programs
#LIBS += -lstdc++


##---------------------------------------------------------------------------
## Make rules
TARGET = fem.cpu.$(FP)

OBJS =  allocate.o input_cntl.o input_grid.o mat_ass_bc.o mat_ass_main.o \
	mat_con0.o mat_con1.o output_ucd.o solve11.o solver_CG.o test1.o util.o

all: show_config $(TARGET)

.SUFFIXES:
.SUFFIXES: .cpp .c .f90 .o

%.o: %.c	
	$(CC)  -c $(FLAGS) $< -o $@

%.o: %.cpp
	$(CXX) -c $(FLAGS) $< -o $@

%.o: %.f90
	mkdir -p mod
	$(F90) -c $(FLAGS) $(FFLAGS) $< -o $@

$(TARGET): $(OBJS)
	$(CXX) $(OBJS) $(LIBS) -o $@
#	$(CC)  $(OBJS) $(LIBS) -o $@
#	$(F90) $(OBJS) $(LIBS) -o $@

install: $(TARGET)
	mkdir -p ../bin ../log; make -C ../dat
	cp -f  $(TARGET) ../bin

clean:
	rm -f $(TARGET) *.o */*.mod *~

show_config:
	@echo "======================================"
	@echo "CPU FP=$(FP)                          "
	@echo "======================================"

input_cntl.o: pfem_util.h pfem_util.h allocate.h
mat_ass_bc.o: pfem_util.h allocate.h
mat_ass_main.o: pfem_util.h allocate.h
mat_con0.o: pfem_util.h allocate.h
mat_con1.o: pfem_util.h allocate.h
output_ucd.o: pfem_util.h allocate.h
solve11.o: pfem_util.h allocate.h
solver_CG.o: pfem_util.h allocate.h
test1.o: pfem_util.h
util.o: precision.h allocate.h
