# ============================================================================
# gpu-apps-tutorial .gitignore
# ============================================================================
# 方針: configure.py が生成するもの・ビルド成果物・実行結果・各種キャッシュを除外する。
# 元の Makefile.miyabi 等 (リファレンスとしてコミット) は除外しない。
# このツリーは <app>/ (diffusion / fem / nbody) が直下にある構成。

# -----------------------------------------------------------------------------
# Python (キャッシュ・仮想環境)
# -----------------------------------------------------------------------------
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
venv/
.python-version
.ipynb_checkpoints/

# -----------------------------------------------------------------------------
# ビルド成果物
# -----------------------------------------------------------------------------
*.o
*.obj
*.mod
*.dwo
*.a
*.so
mod/
bin/
dat/

# -----------------------------------------------------------------------------
# CMake (configure.py --build cmake の生成物)
# -----------------------------------------------------------------------------
build/
build-*/
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CTestTestfile.cmake
_deps/

# 非 Kokkos variant の CMakeLists.txt は configure.py 生成物 (gitignore)
# Kokkos variant の CMakeLists.txt は手書き (committed) なので除外しない
*/C++/openmp-cpu/CMakeLists.txt
*/C++/openmp-target/*/CMakeLists.txt
*/C++/openacc/*/CMakeLists.txt
*/C++/stdpar/*/CMakeLists.txt
*/F/openmp-cpu/CMakeLists.txt
*/F/openmp-target/*/CMakeLists.txt
*/F/openacc/*/CMakeLists.txt
*/F/do-concurrent/*/CMakeLists.txt

# -----------------------------------------------------------------------------
# Make (configure.py --build make の生成物)
# -----------------------------------------------------------------------------
# 生成は Makefile.gen.* なので、元リファレンス Makefile.miyabi.* と衝突しない
Makefile.gen.*

# -----------------------------------------------------------------------------
# configure.py が生成するジョブスクリプト (実行環境の課金グループ等を含むため追跡しない)
# 命名は run.<machine>.<mode>.sh (3 セグメント)。元リファレンス sh/<machine>/run.<mode>.sh
# (2 セグメント) は配下が異なり、このパターンには一致しない。
# -----------------------------------------------------------------------------
run.*.*.sh

# -----------------------------------------------------------------------------
# 実行可能ファイル (アプリのバイナリ)
# 命名規約: <app>.<mode>.<fp>[.<nthreads>]  例: diffusion.gpu.32, nbody.cpu.64
# -----------------------------------------------------------------------------
**/diffusion.gpu.*
**/diffusion.cpu.*
**/diffusion.uni.*
**/fem.gpu.*
**/fem.cpu.*
**/fem.uni.*
**/nbody.gpu.*
**/nbody.cpu.*
**/nbody.uni.*

# -----------------------------------------------------------------------------
# 読者が実行した結果 (空ディレクトリは .gitkeep で保持)
# -----------------------------------------------------------------------------
*/results/miyabi/*
*/results/wisteria/*
*/results/local/*
!*/results/miyabi/.gitkeep
!*/results/wisteria/.gitkeep
!*/results/local/.gitkeep

# -----------------------------------------------------------------------------
# IDE / Editor / OS
# -----------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# -----------------------------------------------------------------------------
# Claude Code 関連
# -----------------------------------------------------------------------------
.claude/
